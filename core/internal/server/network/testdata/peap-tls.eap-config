<?xml version="1.0" encoding="utf-8"?>
<!-- Synthetic: unsupported FAST first, then PEAP (inner EAP 26, two CAs, two servers), then TLS. -->
<EAPIdentityProviderList>
  <EAPIdentityProvider ID="example.org" version="1" lang="en">
    <AuthenticationMethods>
      <AuthenticationMethod>
        <EAPMethod><Type>43</Type></EAPMethod>
      </AuthenticationMethod>
      <AuthenticationMethod>
        <EAPMethod><Type>25</Type></EAPMethod>
        <ServerSideCredential>
          <CA format="X.509" encoding="base64"></CA>
          <CA format="X.509" encoding="base64"></CA>
          <ServerID>a.example.org</ServerID>
          <ServerID>b.example.org</ServerID>
        </ServerSideCredential>
        <ClientSideCredential>
          <OuterIdentity>anon@example.org</OuterIdentity>
        </ClientSideCredential>
        <InnerAuthenticationMethod>
          <EAPMethod><Type>26</Type></EAPMethod>
        </InnerAuthenticationMethod>
      </AuthenticationMethod>
      <AuthenticationMethod>
        <EAPMethod><Type>13</Type></EAPMethod>
      </AuthenticationMethod>
    </AuthenticationMethods>
    <CredentialApplicability>
      <IEEE80211><SSID>corp</SSID></IEEE80211>
      <IEEE80211><SSID>guest</SSID></IEEE80211>
      <IEEE80211><SSID>corp</SSID></IEEE80211>
    </CredentialApplicability>
  </EAPIdentityProvider>
</EAPIdentityProviderList>
